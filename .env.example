# Data persistence. Required for API routes and the worker.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Use "demo" for a deterministic local report, "openai" or "deepseek" for a live model.
RESEARCH_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=16384

# Search. Keep "disabled" for the V1 offline path. "brave" requires a server-side key.
# Do not prefix BRAVE_SEARCH_API_KEY with NEXT_PUBLIC_.
SEARCH_PROVIDER=disabled
BRAVE_SEARCH_API_KEY=
SEARCH_RESULT_COUNT=5
BRAVE_SEARCH_TIMEOUT_MS=8000

# Page reader. Used only when search is enabled. Do not prefix with NEXT_PUBLIC_.
PAGE_READ_TIMEOUT_MS=8000
PAGE_READ_MAX_BYTES=1048576
PAGE_READ_MAX_REDIRECTS=3

# Bounded extra tool calls after the fixed per-competitor search. DeepSeek only.
AGENT_MAX_STEPS=6
REVIEW_MAX_REVISIONS=1

# Worker tuning.
WORKER_ID=local-worker
WORKER_POLL_INTERVAL_MS=1500
